# Copy this file to .env next to leroy.sh and edit it: Leroy reads it on start,
# with no sourcing or exporting needed. Give it mode 0600 and never commit it.
# The file is parsed, not sourced, so only the settings below are read and
# nothing in it is executed.

# Morpheus appliance base URL. Do not include the /api suffix.
MORPHEUS_URL=https://morpheus.example.com

# Access token for a least-privilege Morpheus service account.
# Never commit a real token. Prefer exporting it from a secret manager.
MORPHEUS_API_TOKEN=replace-with-a-morpheus-access-token

# Disabled by default for appliances using an internal or self-signed certificate.
MORPHEUS_VERIFY_TLS=false

# HTTP timeout settings in seconds.
MORPHEUS_CONNECT_TIMEOUT=10
MORPHEUS_REQUEST_TIMEOUT=60

# Output and diagnostic defaults: table|json and error|warn|info|debug.
LEROY_OUTPUT=table
LEROY_LOG_LEVEL=info

# Optional state directory. State contains resource IDs but never passwords.
# LEROY_STATE_DIR=/secure/path/leroy-state
